# Local API settings. Copy this file to server/.env before starting the API.
# Keep the database name, user, and URL-safe password aligned with the root .env file.
STOKSYNC_ENV=development
STOKSYNC_HTTP_ADDR=:8080
STOKSYNC_SHUTDOWN_TIMEOUT=10s
STOKSYNC_DATABASE_URL=postgres://stoksync:replace-with-a-local-dev-password@127.0.0.1:5432/stoksync?sslmode=disable
# pgxpool settings. MinConns may be set to 0 for lazy local development.
STOKSYNC_DATABASE_MAX_CONNS=10
STOKSYNC_DATABASE_MIN_CONNS=2
STOKSYNC_DATABASE_MAX_CONN_LIFETIME=1h
STOKSYNC_DATABASE_MAX_CONN_IDLE_TIME=30m
STOKSYNC_DATABASE_HEALTH_CHECK_PERIOD=1m

# Authentication. Replace the placeholder with a random secret of at least 32 bytes.
STOKSYNC_AUTH_ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-minimum-secret
STOKSYNC_AUTH_ACCESS_TOKEN_TTL=15m
STOKSYNC_AUTH_REFRESH_TOKEN_TTL=2160h
STOKSYNC_AUTH_TOKEN_ISSUER=stoksync-api
STOKSYNC_AUTH_TOKEN_AUDIENCE=stoksync-client
STOKSYNC_AUTH_BCRYPT_COST=12
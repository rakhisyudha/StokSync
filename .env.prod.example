# Production environment template for docker-compose.prod.yml.
# Copy to `.env.prod` on the VPS (kept out of git; do not commit real secrets)
# and replace every placeholder with a unique, random, production-only value.
# This file intentionally combines the PostgreSQL and API settings that
# server/.env.example otherwise splits, because the production composition
# runs both containers from one `docker compose --env-file .env.prod` call.

# --- PostgreSQL (container-internal only; not published to the host) ---
POSTGRES_DB=stoksync
POSTGRES_USER=stoksync
POSTGRES_PASSWORD=replace-with-a-long-random-production-password

# --- API ---
# Port published on the VPS host. Put a TLS-terminating reverse proxy (Caddy,
# nginx, Traefik) in front of this port; do not expose plain HTTP to the
# internet directly.
STOKSYNC_API_PORT=8080
STOKSYNC_SHUTDOWN_TIMEOUT=10s
STOKSYNC_DATABASE_MAX_CONNS=10
STOKSYNC_DATABASE_MIN_CONNS=2
STOKSYNC_DATABASE_MAX_CONN_LIFETIME=1h
STOKSYNC_DATABASE_MAX_CONN_IDLE_TIME=30m
STOKSYNC_DATABASE_HEALTH_CHECK_PERIOD=1m

# Generate with: openssl rand -base64 48
STOKSYNC_AUTH_ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-minimum-secret
STOKSYNC_AUTH_ACCESS_TOKEN_TTL=15m
STOKSYNC_AUTH_REFRESH_TOKEN_TTL=2160h
STOKSYNC_AUTH_TOKEN_ISSUER=stoksync-api
STOKSYNC_AUTH_TOKEN_AUDIENCE=stoksync-client
STOKSYNC_AUTH_BCRYPT_COST=12
